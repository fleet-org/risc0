// A stub <metal_stdlib> for a SYNTAX pass over the Metal shaders with a host C++ compiler
// (groth16_s01/scripts/msl-check.sh). Only what risc0/groth16-metal/src/*.metal needs: the integer
// type names, the intrinsics called, the address-space and function-kind words as no-ops. Not a
// semantic model of Metal — a compile here means "well-formed C++14 with these names", nothing more.
#pragma once
#include <cstdint>
// MSL's integer type names are built in (usable before any include), so they live at global scope.
typedef unsigned int uint;
typedef unsigned long ulong;
typedef unsigned short ushort;
typedef unsigned char uchar;
namespace metal {
inline uint reverse_bits(uint x) { return x; }
inline uint mulhi(uint a, uint b) { return a ^ b; }
inline ulong mulhi(ulong a, ulong b) { return a ^ b; }
template <typename T> inline T select(T a, T b, bool c) { return c ? b : a; }
} // namespace metal
#define kernel
#define device
#define constant
#define thread
#define threadgroup
// MSL built-in scalar type names that the shaders never use as types: any use is an error here, so
// a variable named after one (the `half` that would have failed the first Mac run) fails on Linux.
#pragma GCC poison half float double char short quad packed_float2 packed_float3 packed_float4
